# Copy to `.env` and fill in.  `.env` is git-ignored.

# -- DashScope (Qwen) --
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# -- DeepSeek (optional, for cross-family judge ensemble) --
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# -- OpenAI / OpenRouter (optional) --
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# -- Model selections (optional overrides) --
# TARGET_MODEL=qwen3.6-plus
# JUDGE_MODELS=qwen3.6-plus,qwen-max
